    "num_workers": 4,
    "image_size": 224,
    "training_mode": "regression",
    "high_quality_only": true,
    "joint_margin": 5.0,
    
    "model_path": "outputs/checkpoints/best_model.pth",
    "preds_file": "outputs/tables/test_predictions.csv",
    "out_rank": "outputs/tables/resistance_leaderboard.csv",
    
    "log_file": "outputs/logs/training_log.csv"
